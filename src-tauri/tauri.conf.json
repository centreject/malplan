{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "malplan",
  "version": "0.2.2",
  "identifier": "com.centreject.malplan",
  "build": {
    "beforeDevCommand": "npm run build:mcp && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:mcp",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "malplan",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "binaries/llama/": "llama/",
      "../dist-mcp/malplan-mcp.mjs": "mcp/malplan-mcp.mjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQUMzRTJBMzYyQjQ1NTQKUldSVVJTczJLajZzc2V3c3J1WkJXeldiTXRSZm9ja0Rrc0ZHRTl3eTZLTk1LakRZNWpINzRDa0gK",
      "endpoints": [
        "https://github.com/centreject/malplan/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
